# Copy to .env.local for local development. Vercel gets the same names in project settings.

# The shared Supabase project (Settings > API). The anon key is safe in the
# browser; row level security is what protects the data. MealPrep's tables
# live in the app_mealprep schema, which must be listed under
# Settings > API > Exposed schemas.
NEXT_PUBLIC_SUPABASE_URL=https://rxwyuqcsifohiiyvyink.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# MealPrep's own Google Cloud client ID. Not a secret; it ships to the
# browser by design. See docs/SETUP-GOOGLE.md.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Anthropic API key. Server only, used by app/api/structure (Phase 7).
ANTHROPIC_API_KEY=
