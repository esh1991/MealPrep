# Copy to .env.local for local development. Vercel gets the same names in project settings.

# Supabase project (Settings > API). The anon key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic API key. Server only, used by app/api/structure (Phase 7).
ANTHROPIC_API_KEY=
